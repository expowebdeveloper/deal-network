# Copy to .env — docker compose interpolates these into docker-compose.yml for
# the `db` service and the backend's DATABASE_URL. Not used when running on the
# host directly; that reads backend/.env.
POSTGRES_USER=dealnetwork
POSTGRES_PASSWORD=generate-one-e.g.-python3-c-"import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_DB=deal_network
