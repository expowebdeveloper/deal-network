# Overrides for the containerised stack (docker-compose.yml).
#
# docker-compose.yml lists this AFTER .env, so these values win inside the
# containers while `.env` stays correct for running on the host directly.
# Gitignored, like every .env variant — it carries the database password.
#
# DATABASE_URL is set in docker-compose.yml, pointing at the `db` service,
# so the password lives in ./.env only. Uncomment and edit the line below
# (and drop the `environment:` override in compose) to use a host database
# instead — localhost inside a container is the container, so it has to be
# host.docker.internal, and the host Postgres must accept bridge connections.
#DATABASE_URL=postgresql+asyncpg://<user>:<password>@host.docker.internal:5432/deal_network

# The container publishes the API on 8002 and the app on 5176.
CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
FRONTEND_URL=http://localhost:5176

# NOTE: this exact URI must also be added under "Authorised redirect URIs" in
# the Google Cloud console, alongside the port-8000 one used on the host.
GOOGLE_REDIRECT_URI=http://localhost:8002/auth/google/callback
