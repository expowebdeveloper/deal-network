APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/deal_network

# Required. Must be at least 32 characters — the app refuses to start otherwise.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# The redirect URI below must be listed there verbatim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Apple Sign In — optional. Leave APPLE_CLIENT_ID blank to disable the provider.
# APPLE_PRIVATE_KEY is the contents of the .p8 file (newlines may be written as \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/auth/apple/callback

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail: SMTP_PASS must be an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Deal Network
SMTP_STARTTLS=true
EMAIL_ENABLED=true
