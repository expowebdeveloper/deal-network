APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/deal_network

# Required. Must be at least 32 characters — the app refuses to start otherwise.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# The redirect URI below must be listed there verbatim.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Apple Sign In — optional. Leave APPLE_CLIENT_ID blank to disable the provider.
# APPLE_PRIVATE_KEY is the contents of the .p8 file (newlines may be written as \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/auth/apple/callback

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail: SMTP_PASS must be an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Deal Network
SMTP_STARTTLS=true
EMAIL_ENABLED=true

# --- Stripe ----------------------------------------------------------------
# All optional. Leave STRIPE_SECRET_KEY blank and the app still runs: the
# /api/v1/billing checkout, portal and webhook endpoints answer 503 and
# everything else is unaffected.
#
# Dashboard -> Developers -> API keys. Test and live mode have separate sets.
STRIPE_SECRET_KEY=
# Safe to expose; the SPA needs it to redirect to Checkout.
STRIPE_PUBLISHABLE_KEY=

# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
# In development, `stripe listen --forward-to localhost:8000/api/v1/billing/webhook`
# prints one. Without it the webhook refuses every delivery, because an
# unverified POST to that URL would be a way to grant yourself a paid plan.
STRIPE_WEBHOOK_SECRET=

# Recurring Price ids (price_…, NOT product ids — prod_… will not work).
# Create them under Dashboard -> Product catalogue: $25/month and $100/month.
# Until these are set the paid tiers show "Not available yet" on the plan cards
# instead of offering a button that could only fail.
STRIPE_PRICE_MEMBER=
STRIPE_PRICE_PROFESSIONAL=

# Only for stripe-mock (https://github.com/stripe/stripe-mock), which lets the
# billing path be tested without a Stripe account. Leave blank everywhere else;
# the app refuses to use it when APP_ENV is production.
#STRIPE_API_BASE=http://localhost:12111

# Where Stripe returns the browser. Appended to FRONTEND_URL.
# These must stay in step with the SPA's routes — /billing/success is handled by
# frontend/src/components/billing/BillingReturn.jsx, which confirms the session
# and then sends the member into the app. Change one, change the other.
# `?session_id={CHECKOUT_SESSION_ID}` is appended to the success path
# automatically; that is what the page reads back.
STRIPE_SUCCESS_PATH=/billing/success
STRIPE_CANCEL_PATH=/plans
STRIPE_PORTAL_RETURN_PATH=/plans

# How long a plan chosen on the pricing page stays valid through signup.
SIGNUP_INTENT_TTL_MINUTES=60

# --- Uploads -----------------------------------------------------------------
# Largest single file this deployment accepts, per kind, in bytes. These are the
# infrastructure ceiling. The plan's own `files.max_file_size_bytes` is a
# separate one, and whichever is smaller applies — so raising a number here does
# not hand Early Access a bigger allowance than its tier grants.
#
# The body-size middleware is sized from the largest of the three, so a video
# does not have to squeeze under the document limit.
#
# Attachments are allow-listed: images (JPEG, PNG, GIF, WebP), video (MP4, WebM,
# MOV), PDF, TXT, CSV, DOC(X) and XLS(X). Executables and archives (.exe, .zip,
# .rar, .7z, …) are refused by content type and by extension.
# Values are plain integers with no trailing comment: docker's --env-file
# passes the whole line through as the value, unlike dotenv which strips one.
# 10 MB
MAX_IMAGE_BYTES=10485760
# 30 MB
MAX_VIDEO_BYTES=31457280
# 25 MB
MAX_DOCUMENT_BYTES=26214400

# Where uploads are written, relative to the backend directory.
UPLOAD_DIR=uploads
